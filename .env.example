# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL local (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Base de datos compartida (Supabase)
# Copiá las dos URLs desde Supabase > Connect y reemplazá [PASSWORD] por la
# contraseña de la base. La contraseña NUNCA se sube al repositorio.
#
# DATABASE_URL: transaction pooler (puerto 6543). La usa la API y el seed.
#   `sslmode=no-verify` cifra la conexión; sin él, `pg` intenta validar el
#   certificado de Supabase contra las CA del sistema y falla.
# DIRECT_URL: session pooler (puerto 5432). La usa el CLI de Prisma
#   (migrate deploy, studio).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST].pooler.supabase.com:6543/postgres?sslmode=no-verify
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST].pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Postgres local de Docker (base de pruebas, se puede borrar sin problema)
# Se usa automáticamente para lo que BORRA datos:
#   - npm run prisma:migrate (migrate dev) y npm run db:reset (migrate reset)
#   - npm run test:e2e
# Nunca debe apuntar a Supabase.
# ---------------------------------------------------------------------------
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/si_be_boilerplate?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Cocina
# ---------------------------------------------------------------------------
COCINA_MINUTOS_RETRASO=15

# Orígenes del frontend permitidos, separados por coma.
# FRONTEND_URL=http://localhost:3001