# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL local (consumido por docker-compose para inicializar el contenedor)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=si_be_boilerplate
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Base de datos compartida (Supabase)
# DATABASE_URL: transaction pooler (puerto 6543). La usan la API y el seed.
#   La conexión va cifrada y valida el certificado de Supabase con el CA de
#   certs/supabase-ca.crt (ver certs/README.md). No uses sslmode=no-verify.
# DIRECT_URL: session pooler (puerto 5432). La usa el CLI de Prisma
#   (migrate deploy, migrate status, studio).
#
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres.xmiwcuzjywicxymtbhvs:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xmiwcuzjywicxymtbhvs:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Postgres local de Docker (base de pruebas, se puede borrar sin problema)
# Obligatoria para lo que BORRA datos, que nunca corre contra Supabase:
#   - npm run prisma:migrate (migrate dev) y npm run db:reset (migrate reset)
#   - npm run test:e2e
# Tiene que apuntar a localhost, 127.0.0.1 o ::1; si no, esos comandos fallan.
# ---------------------------------------------------------------------------
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/si_be_boilerplate?schema=public

# npm run test:e2e también crea y migra en este servidor las bases temporales
# de H10, H11 y H17 (h10_test, h11_test, h17_test).
# No hace falta definir TEST_DATABASE_URL ni PAGOS_TEST_DATABASE_URL.

# ---------------------------------------------------------------------------
# Autenticación
# Generá un secreto propio: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Cocina
# ---------------------------------------------------------------------------
COCINA_MINUTOS_RETRASO=15

# Orígenes del frontend permitidos, separados por coma.
# FRONTEND_URL=http://localhost:3001